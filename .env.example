# ---------------------------------------------------------------------------
# Copy to .env.local for local dev. NEVER commit the filled-in file.
# On Vercel these live in Project Settings -> Environment Variables.
# ---------------------------------------------------------------------------

# Neon Postgres, one project with two branches:
#   main  production. Only Vercel's Production environment uses it.
#   dev   a copy of main for local dev, Vercel Preview and Development, and
#         for trying migrations first (`npm run db:migrate`). If a PR with a
#         migration is abandoned, use "Reset from parent" on dev in Neon.
# Locally this points at dev. Keep production's URL commented out, so no
# local command reaches it by accident.
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# Production's database host, the ep-... part of its URL (the -pooler
# variant counts as the same host). Lives only in .env.local, never on Vercel.
# `npm run db:migrate` refuses this host unless CONFIRM_PROD=1, and refuses
# to run at all while this is empty.
PROD_DB_HOST=""

# Never in a file. Set it on the command line for a deliberate production run:
#   CONFIRM_PROD=1 DATABASE_URL="<prod url>" npm run db:migrate
# The explicit DATABASE_URL wins, because dotenv never overrides a variable
# that is already set.
# CONFIRM_PROD=1

# Auth.js session signing key. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Google OAuth client (Google Cloud Console -> Credentials -> OAuth client ID).
# Auth.js v5 auto-detects these exact names — no provider wiring needed.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Required so Auth.js trusts the host header behind Vercel's proxy.
AUTH_TRUST_HOST=true

# The original five, as "email:HebrewName" pairs, comma separated. Only the
# seed reads it now (`npm run db:seed` on a fresh database). Who may sign in,
# and as what, lives in group_members, managed in the app.
ALLOWED_USERS="ido@example.com:עידו,nir@example.com:ניר,saar@example.com:סער,or@example.com:אור,itzhak@example.com:יצחק"

# Read-only guests from before groups, same "email:name" format. Each one is
# imported as a viewer of the original group on their first sign-in, and only
# then. Temporary: deleted in phase 7 of docs/groups-and-trips.md.
VIEWER_USERS=""

# Web Push (VAPID). Generate once with: npx web-push generate-vapid-keys
# Keep the pair stable — rotating it invalidates every existing subscription.
# On Vercel set these as **Config** type, not Secret (Secret never reaches runtime).
#
# Production's pair is for Production only. The dev branch holds copies of
# everyone's push subscriptions, and a subscription accepts pushes signed by
# the key pair it was created with, so production's pair on a preview would
# buzz real phones. To test push on a preview, give Preview a pair of its own:
# it can only reach phones that subscribed on a preview. Locally, leave the
# private key unset or use your own pair, for the same reason.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# Email reminders via Gmail SMTP. Use an App Password (Google Account ->
# Security -> App passwords), not the account password. Without these,
# sending reminders fails with a clear error and nothing else breaks.
# Production only: the dev branch has everyone's real addresses, so these on
# a preview could email the whole group.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
