# ---------------------------------------------------------------------------
# Copy to .env.local for local dev. NEVER commit the filled-in file.
# On Vercel these live in Project Settings -> Environment Variables.
# ---------------------------------------------------------------------------

# Neon Postgres. Injected automatically by the Vercel <-> Neon integration;
# pull it locally with: vercel env pull .env.local
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# Auth.js session signing key. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Google OAuth client (Google Cloud Console -> Credentials -> OAuth client ID).
# Auth.js v5 auto-detects these exact names — no provider wiring needed.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Required so Auth.js trusts the host header behind Vercel's proxy.
AUTH_TRUST_HOST=true

# Access list: "email:HebrewName" pairs, comma separated.
# Gates who may sign in, and supplies each person's display name.
# Roles (admin / shopper) are NOT here — they live in the users table.
ALLOWED_USERS="ido@example.com:עידו,nir@example.com:ניר,saar@example.com:סער,or@example.com:אור,itzhak@example.com:יצחק"

# Web Push (VAPID). Generate once with: npx web-push generate-vapid-keys
# Keep the pair stable — rotating it invalidates every existing subscription.
# On Vercel set these as **Config** type, not Secret (Secret never reaches runtime).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"
